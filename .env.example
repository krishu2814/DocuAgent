# App Settings
PROJECT_NAME="DocuAgent"
ENVIRONMENT=development

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/docuagent

# LLM Provider: Groq (Free fast inference)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Embedding Provider: Hugging Face / Sentence Transformers (Free & Local)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
HUGGINGFACE_API_KEY=optional_hf_token_if_using_api

# File Storage
UPLOAD_DIR=./uploads
