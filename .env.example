# ==============================================================================
# DocuAgent Environment Variables Configuration
# ==============================================================================

# Application Mode
PROJECT_NAME=DocuAgent
ENVIRONMENT=production

# Frontend Origin (Used for CORS in Production when frontend is on Vercel)
# Example: https://docuagent.vercel.app (Leave empty or set to * for local development)
FRONTEND_URL=

# Database Connection (Managed PostgreSQL with pgvector extension enabled)
# Example for Neon/Supabase/Render: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/docuagent

# LLM Provider: Groq Cloud (Free fast inference)
# Obtain a free key from: https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Embedding Model: Hugging Face Sentence-Transformers (Runs free & locally)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
HUGGINGFACE_API_KEY=

# File Storage Directory (Used for temporary processing before chunking)
UPLOAD_DIR=./uploads
